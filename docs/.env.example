# Copy to .env.local. The agents read agents/.env. Never commit real values.

# --- Web app (browser-safe) ---
NEXT_PUBLIC_STDB_URI=              # SpacetimeDB host (Maincloud, or ws://localhost:3000 for local)
NEXT_PUBLIC_STDB_MODULE=hippocratech

# --- Node server (apps/web/server, apps/web/app/api) ---
STDB_URI=                          # same host, used by /api/memo
STDB_SERVER_TOKEN=                 # token for the server identity stored in the module's config table
ANTHROPIC_API_KEY=                 # /api/memo
ANTHROPIC_MODEL=

# --- Watchers (apps/watcher) ---
STDB_URI=                          # same host
STDB_SERVER_TOKEN=                 # same server identity (the publisher's: `spacetime login show --token`)
COORDINATOR_URL=                   # Sign-off Coordinator REST endpoint (start_round, reassess, resume)
ENGINE_URL=                        # Python engine the run driver calls (default http://127.0.0.1:8000)
STDB_MODULE=                       # default NEXT_PUBLIC_STDB_MODULE, then hippocratech
RELAY_PORT=                        # port the agents post messages and status to (default 8010)
RELAY_TOKEN=                       # agents must send this to the relay

# --- Agents (agents/.env) ---
AGENTVERSE_API_KEY=                # Agentverse API key; with AGENT_MAILBOX=1 each agent connects its own mailbox (no Inspector clicks)
INVENTORY_AGENT_SEED=              # one seed phrase per uAgent (stable addresses)
FLOW_AGENT_SEED=
CLINICAL_WORKFLOW_AGENT_SEED=
COORDINATOR_AGENT_SEED=
ASI1_API_KEY=                      # llm.py explain(): ASI:One (asi1-mini) words the agents' messages, labeled "asi1"; wins over Claude
ANTHROPIC_API_KEY=                 # llm.py: propose() and explain() when ASI1_API_KEY is unset; with neither key the agents stop with an error (no fallback text)
ANTHROPIC_MODEL=                   # default claude-haiku-5-5
WATCHER_RELAY_URL=                 # the watcher relay, e.g. http://127.0.0.1:8010 (messages and status)
RELAY_TOKEN=                       # must match the watcher's
HIPPO_SIM_BIN=                     # path to the hippo-sim binary
HIPPO_SIM_FIXTURES=0               # 1 = read results from agents/fixtures/results/ (relay rows say "fixture": true)
HIPPO_OPT_BIN=                     # path to the hippo-opt CLI; unset = agents/fixtures/candidates/
AGENT_MAILBOX=0                    # 1 = receive through an Agentverse mailbox
LOCAL_RESOLVE=1                    # 1 = the four agents reach each other at 127.0.0.1:8001-8004 (others, e.g. ASI:One users, still resolve normally in mailbox mode)
LOCAL_PEERS=                       # tests/dev only: extra agent1q...=http://127.0.0.1:<port>/submit pairs for the local resolver
HOSPITAL_PATH=                     # default agents/fixtures/hospital.json
HIPPO_WEB_URL=                     # agents: the web app, for the live "watch the agents" link in ASI:One replies (default http://localhost:3000)
RELAY_LOG_DIR=                     # default agents/logs; used when WATCHER_RELAY_URL is unset
