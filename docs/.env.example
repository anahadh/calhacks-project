# Copy to .env.local. The agents read agents/.env. Never commit real values.

# --- Web app (browser-safe) ---
NEXT_PUBLIC_STDB_URI=              # SpacetimeDB host (Maincloud, or ws://localhost:3000 for local)
NEXT_PUBLIC_STDB_MODULE=hippocratech

# --- Node server (apps/web/server, apps/web/app/api) ---
STDB_URI=                          # same host, used by the Droid runner and /api/memo
STDB_SERVER_TOKEN=                 # token for the server identity stored in the module's config table
ANTHROPIC_API_KEY=                 # /api/memo
ANTHROPIC_MODEL=
FACTORY_API_KEY=                   # Droid SDK
DROID_WORKSPACE_ROOT=              # temp folder for per-request sandboxes
WATCHER_RELAY_URL=                 # where the Droid runner posts its steps and diffs

# --- Watchers (apps/watcher) ---
STDB_URI=                          # same host
STDB_SERVER_TOKEN=                 # same server identity
COORDINATOR_URL=                   # Sign-off Coordinator REST endpoint (start_round, reassess, resume)
RELAY_PORT=                        # port the agents post messages and status to
RELAY_TOKEN=                       # agents must send this to the relay

# --- Agents (agents/.env) ---
AGENTVERSE_API_KEY=                # Fetch.ai Agentverse
INVENTORY_AGENT_SEED=              # one seed phrase per uAgent (stable addresses)
FLOW_AGENT_SEED=
CLINICAL_WORKFLOW_AGENT_SEED=
COORDINATOR_AGENT_SEED=
ANTHROPIC_API_KEY=                 # llm.py: propose() and explain()
ANTHROPIC_MODEL=
WATCHER_RELAY_URL=                 # the watcher relay, for messages, status, and live state reads
RELAY_TOKEN=                       # must match the watcher's
APP_URL=                           # Next.js server, for /api/droid
HIPPO_SIM_BIN=                     # path to the hippo-sim binary
